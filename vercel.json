{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "fastapi": {
      "root": "backend",
      "framework": "fastapi"
    },
    "vite": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "fastapi"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "vite"
      }
    }
  ]
}
